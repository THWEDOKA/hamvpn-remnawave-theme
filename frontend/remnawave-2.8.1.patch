+                        Только технический результат и затронутые объекты — без SSH-данных и
+                        токенов.
+                    </Text>
+                </Stack>
+                <ThemeIcon color="gray" radius="md" size="lg" variant="light">
+                    <TbHistory size={20} />
+                </ThemeIcon>
+            </Group>
+            <ScrollArea>
+                <Table highlightOnHover miw={720} verticalSpacing="sm">
+                    <Table.Thead>
+                        <Table.Tr>
+                            <Table.Th>Операция</Table.Th>
+                            <Table.Th>Объект</Table.Th>
+                            <Table.Th>Время</Table.Th>
+                            <Table.Th>Состояние</Table.Th>
+                        </Table.Tr>
+                    </Table.Thead>
+                    <Table.Tbody>
+                        {operations.length ? (
+                            operations.map((operation) => (
+                                <Table.Tr key={operation.id}>
+                                    <Table.Td>
+                                        {{
+                                            'node-add': 'Добавление ноды',
+                                            'ip-change': 'Смена IP',
+                                            'gconfig-install': 'Установка G-CONFIG',
+                                            'gconfig-adopt': 'Подключение действующего хоста',
+                                            'gconfig-route-prepare': 'Подготовка входа РФ',
+                                            'gconfig-route-switch': 'Смена маршрута'
+                                        }[operation.type] || operation.type}
+                                    </Table.Td>
+                                    <Table.Td>
+                                        <Text fw={600} size="sm">
+                                            {operation.resource}
+                                        </Text>
+                                        {operation.result?.warning && (
+                                            <Text size="xs" c="red">
+                                                {operation.result.warning}
+                                            </Text>
+                                        )}
+                                        {operation.state === 'applying' && (
+                                            <Text size="xs" c="dimmed">
+                                                {operation.result?.stage}
+                                            </Text>
+                                        )}
+                                        {!!operation.result?.rollbackErrors?.length && (
+                                            <Text size="xs" c="red">
+                                                {operation.result.rollbackErrors.join(', ')}
+                                            </Text>
