+export function InfrastructurePage() {
+    const token = useToken()
+    const [inventory, setInventory] = useState<Inventory | null>(null)
+    const [operations, setOperations] = useState<Operation[]>([])
+    const [loading, setLoading] = useState(true)
+
+    const load = async (quiet = false) => {
+        if (!token) return
+        if (!quiet) setLoading(true)
+        try {
+            const [inventoryResult, operationsResult] = await Promise.all([
+                api<Inventory>(token, '/inventory'),
+                api<{ operations: Operation[] }>(token, '/operations')
+            ])
+            setInventory(inventoryResult)
+            setOperations(operationsResult.operations)
+        } catch (error) {
+            notifications.show({ color: 'red', message: errorMessage(error) })
+        } finally {
+            setLoading(false)
+        }
+    }
+
+    useEffect(() => {
+        if (!token) {
+            return
+        }
+        let cancelled = false
+        Promise.all([
+            api<Inventory>(token, '/inventory'),
+            api<{ operations: Operation[] }>(token, '/operations')
+        ])
+            .then(([inventoryResult, operationsResult]) => {
+                if (cancelled) return
+                setInventory(inventoryResult)
+                setOperations(operationsResult.operations)
+            })
+            .catch((error: unknown) => {
+                if (!cancelled) {
+                    notifications.show({ color: 'red', message: errorMessage(error) })
+                }
+            })
+            .finally(() => {
+                if (!cancelled) setLoading(false)
+            })
+        return () => {
+            cancelled = true
+        }
+    }, [token])
+
+    const statusText = useMemo(() => {
+        if (!inventory) return 'Получаем данные'
+        const offline = inventory.summary.nodes - inventory.summary.connectedNodes
+        return offline === 0 ? 'Все ноды на связи' : `Требуют внимания: ${offline}`
+    }, [inventory])
+
+    return (
+        <Page title="Инфраструктура">
+            <Stack gap="lg">
+                <PageHeaderShared
+                    actions={
+                        <Badge
+                            color={
+                                inventory?.summary.connectedNodes === inventory?.summary.nodes
+                                    ? 'teal'
+                                    : 'yellow'
+                            }
+                            size="lg"
+                            variant="light"
+                        >
+                            {statusText}
+                        </Badge>
+                    }
+                    icon={<TbServerCog size={24} />}
+                    title="Инфраструктура"
+                />
+
+                {loading || !inventory ? (
+                    <LoadingScreen height="60vh" />
+                ) : (
+                    <Tabs defaultValue="overview" keepMounted={false} variant="outline">
+                        <Tabs.List>
+                            <Tabs.Tab
+                                leftSection={<TbActivityHeartbeat size={16} />}
+                                value="overview"
+                            >
+                                Обзор
+                            </Tabs.Tab>
+                            <Tabs.Tab leftSection={<TbPlus size={16} />} value="node-add">
+                                Добавить ноду
+                            </Tabs.Tab>
+                            <Tabs.Tab
+                                leftSection={<TbArrowsExchange size={16} />}
+                                value="ip-change"
+                            >
+                                Смена IP
+                            </Tabs.Tab>
+                            <Tabs.Tab leftSection={<TbHistory size={16} />} value="history">
+                                Журнал
+                            </Tabs.Tab>
+                        </Tabs.List>
+
+                        <Tabs.Panel pt="lg" value="overview">
+                            <InventoryView
+                                inventory={inventory}
+                                onRefresh={() => void load(true)}
+                            />
+                        </Tabs.Panel>
+                        <Tabs.Panel pt="lg" value="node-add">
+                            <NodeAddView
+                                inventory={inventory}
+                                onComplete={() => void load(true)}
+                                token={token}
+                            />
+                        </Tabs.Panel>
+                        <Tabs.Panel pt="lg" value="ip-change">
+                            <IpChangeView
+                                inventory={inventory}
+                                onComplete={() => void load(true)}
+                                token={token}
+                            />
+                        </Tabs.Panel>
+                        <Tabs.Panel pt="lg" value="history">
+                            <HistoryView operations={operations} />
+                        </Tabs.Panel>
+                    </Tabs>
+                )}
+            </Stack>
+        </Page>
+    )
+}
