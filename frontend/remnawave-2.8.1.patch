+function HistoryView({ operations }: { operations: Operation[] }) {
+    return (
+        <Paper p="lg" radius="md" withBorder>
+            <Group justify="space-between" mb="md">
+                <Stack gap={2}>
+                    <Title order={4}>Журнал операций</Title>
