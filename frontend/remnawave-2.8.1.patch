+    Text,
+    Textarea,
+    TextInput,
+    ThemeIcon,
+    Title
+} from '@mantine/core'
+import { notifications } from '@mantine/notifications'
+import axios from 'axios'
+import { useEffect, useMemo, useState } from 'react'
+import {
+    TbActivityHeartbeat,
+    TbAlertTriangle,
+    TbArrowsExchange,
+    TbCheck,
+    TbHistory,
+    TbPlus,
+    TbRefresh,
+    TbServerCog,
+    TbShieldCheck,
+    TbTopologyStar3
+} from 'react-icons/tb'
+
+import { LoadingScreen, Page, PageHeaderShared } from '@shared/ui'
+
+import { useToken } from '@entities/auth'
+
+type Summary = {
+    connectedNodes: number
+    hosts: number
+    nodes: number
+    profiles: number
+    squads: number
+}
+
+type NodeItem = {
+    address: string
+    countryCode?: string
+    isConnected: boolean
+    isDisabled: boolean
+    name: string
+    port: number
+    profileName?: string
+    uuid: string
+}
+
+type InboundItem = { tag?: string; type?: string; uuid: string }
+type ProfileItem = { inbounds: InboundItem[]; name: string; uuid: string }
+type SquadItem = { name: string; uuid: string }
+
+type Inventory = {
+    cloudflare: { configured: boolean; zones: string[] }
+    hosts: unknown[]
+    nodes: NodeItem[]
+    profiles: ProfileItem[]
+    squads: SquadItem[]
+    summary: Summary
+}
+
+type Operation = {
+    createdAt: string
+    id: string
+    impact: Record<string, number>
+    resource: string
+    state: string
+    type: string
+    updatedAt: string
+}
+
+type SshCheck = {
+    architecture: string
+    distribution: string
+    docker: string
+    existingNode: boolean
+    fingerprint: string
+}
+
+type IpPlan = {
+    dns: {
+        configured: boolean
+        hostnames: string[]
+        records: {
+            hostname: string
+            newAddress: string
+            newTtl: number
+            oldAddress: string
+            proxyWasEnabled: boolean
+        }[]
+    }
+    hosts: { newAddress?: string; oldAddress: string; remark: string; willChange: boolean }[]
+    impact: { dnsRecords: number; hosts: number; nodes: number; profileValues: number }
+    node: { name: string; newAddress: string; oldAddress: string; port: number }
+    operationId: string
+    profiles: { matches: number; name: string }[]
+    warnings: string[]
+}
+
+type NodePlan = {
+    host: {
+        address: string
+        enabled: boolean
+        excludedSquadUuids: string[]
+        port: number
+        remark: string
+        squadUuids: string[]
+    }
+    node: {
+        address: string
+        inboundUuids: string[]
+        name: string
+        port: number
+        profileName: string
+    }
+    operationId: string
+}
+
+type SshForm = {
+    host: string
+    password: string
+    port: number
+    privateKey: string
+    username: string
+}
+
+type NodeForm = {
+    address: string
+    countryCode: string
+    inboundUuids: string[]
+    name: string
+    port: number
+    profileUuid: string
+}
+
+type HostForm = {
+    address: string
+    enabled: boolean
+    fingerprint: string
+    inboundUuid: string
+    port: number
+    remark: string
+    sni: string
+    squadUuids: string[]
+}
+
+const API_BASE = '/ham-infrastructure/api'
+
+const api = async <T,>(token: string, path: string, method = 'GET', body?: unknown): Promise<T> => {
+    if (!token) throw new Error('Сессия панели ещё не готова. Обновите страницу.')
+    const response = await axios.request<T>({
+        data: body,
+        headers: { Authorization: `Bearer ${token}` },
+        method,
+        url: `${API_BASE}${path}`
+    })
+    return response.data
+}
+
+const errorMessage = (error: unknown): string => {
+    if (typeof error === 'object' && error && 'response' in error) {
+        const response = (error as { response?: { data?: { detail?: string } } }).response
+        if (response?.data?.detail) return response.data.detail
+    }
+    return error instanceof Error ? error.message : 'Неизвестная ошибка'
+}
+
+const stateColor = (state: string): string => {
+    if (state === 'completed') return 'teal'
+    if (state === 'planned') return 'blue'
+    if (state === 'applying') return 'yellow'
+    return 'red'
+}
+
+const stateLabel = (state: string): string => {
+    const labels: Record<string, string> = {
+        applying: 'Выполняется',
+        completed: 'Завершено',
+        planned: 'План готов',
+        rollback_failed: 'Откат неполный',
+        rolled_back: 'Отменено и откачено'
+    }
+    return labels[state] ?? state
+}
+
+function MetricCard({ color, label, value }: { color: string; label: string; value: number }) {
+    return (
+        <Card padding="lg" radius="md" withBorder>
+            <Group justify="space-between">
+                <Stack gap={2}>
+                    <Text c="dimmed" fw={600} size="xs" tt="uppercase">
+                        {label}
+                    </Text>
+                    <Title order={2}>{value}</Title>
+                </Stack>
+                <ThemeIcon color={color} radius="md" size="xl" variant="light">
+                    <TbActivityHeartbeat size={24} />
+                </ThemeIcon>
+            </Group>
+        </Card>
+    )
+}
+
+function InventoryView({ inventory, onRefresh }: { inventory: Inventory; onRefresh: () => void }) {
+    return (
+        <Stack gap="lg">
+            <SimpleGrid cols={{ base: 1, sm: 2, xl: 5 }} spacing="md">
+                <MetricCard color="blue" label="Ноды" value={inventory.summary.nodes} />
+                <MetricCard
+                    color="teal"
+                    label="На связи"
+                    value={inventory.summary.connectedNodes}
+                />
+                <MetricCard color="violet" label="Хосты" value={inventory.summary.hosts} />
+                <MetricCard color="grape" label="Профили" value={inventory.summary.profiles} />
+                <MetricCard color="cyan" label="Сквады" value={inventory.summary.squads} />
+            </SimpleGrid>
+
+            <Paper p="lg" radius="md" withBorder>
+                <Group justify="space-between" mb="md">
+                    <Stack gap={2}>
+                        <Title order={4}>Состояние нод</Title>
+                        <Text c="dimmed" size="sm">
+                            Актуальные адреса, профили и состояние соединения
+                        </Text>
+                    </Stack>
+                    <Button
+                        leftSection={<TbRefresh size={16} />}
+                        onClick={onRefresh}
+                        variant="light"
+                    >
+                        Обновить
+                    </Button>
+                </Group>
+                <ScrollArea>
+                    <Table highlightOnHover miw={760} verticalSpacing="sm">
+                        <Table.Thead>
+                            <Table.Tr>
+                                <Table.Th>Нода</Table.Th>
+                                <Table.Th>Адрес</Table.Th>
+                                <Table.Th>Профиль</Table.Th>
+                                <Table.Th>Состояние</Table.Th>
+                            </Table.Tr>
+                        </Table.Thead>
+                        <Table.Tbody>
+                            {inventory.nodes.map((node) => (
+                                <Table.Tr key={node.uuid}>
+                                    <Table.Td>
+                                        <Text fw={600} size="sm">
+                                            {node.countryCode || 'XX'} · {node.name}
+                                        </Text>
+                                    </Table.Td>
+                                    <Table.Td>
+                                        <Code>
+                                            {node.address}:{node.port}
+                                        </Code>
+                                    </Table.Td>
+                                    <Table.Td>{node.profileName || 'Не назначен'}</Table.Td>
+                                    <Table.Td>
+                                        <Badge
+                                            color={
+                                                node.isConnected && !node.isDisabled
+                                                    ? 'teal'
+                                                    : 'red'
+                                            }
+                                            variant="light"
+                                        >
+                                            {node.isDisabled
+                                                ? 'Отключена'
+                                                : node.isConnected
+                                                  ? 'На связи'
+                                                  : 'Нет связи'}
+                                        </Badge>
+                                    </Table.Td>
+                                </Table.Tr>
+                            ))}
+                        </Table.Tbody>
+                    </Table>
+                </ScrollArea>
+            </Paper>
+        </Stack>
+    )
+}
+
+function IpChangeView({
+    inventory,
+    onComplete,
+    token
+}: {
+    inventory: Inventory
+    onComplete: () => void
+    token: string
+}) {
+    const [nodeUuid, setNodeUuid] = useState<string | null>(null)
+    const [newAddress, setNewAddress] = useState('')
+    const [confirmation, setConfirmation] = useState('')
+    const [plan, setPlan] = useState<IpPlan | null>(null)
+    const [busy, setBusy] = useState(false)
+    const [cloudflareBusy, setCloudflareBusy] = useState(false)
+    const [cloudflareToken, setCloudflareToken] = useState('')
+    const [cloudflareZone, setCloudflareZone] = useState('hambot.ru')
+
+    const connectCloudflare = async () => {
+        if (cloudflareToken.length < 20 || !cloudflareZone.trim()) return
+        setCloudflareBusy(true)
+        try {
+            await api<{ configured: boolean; ttl: number; zone: string }>(
+                token,
+                '/cloudflare/config',
+                'POST',
+                { token: cloudflareToken, zone: cloudflareZone.trim() }
+            )
+            setCloudflareToken('')
+            notifications.show({
+                color: 'teal',
+                message: 'Cloudflare DNS подключён и проверен'
+            })
+            onComplete()
+        } catch (error) {
+            notifications.show({ color: 'red', message: errorMessage(error) })
+        } finally {
+            setCloudflareBusy(false)
+        }
+    }
+
+    const createPlan = async () => {
+        if (!nodeUuid || !newAddress.trim()) return
+        setBusy(true)
+        try {
+            const result = await api<IpPlan>(token, '/ip-change/plan', 'POST', {
+                nodeUuid,
+                newAddress: newAddress.trim()
+            })
+            setPlan(result)
+            setConfirmation('')
+            notifications.show({ color: 'blue', message: 'План зависимостей сформирован' })
+        } catch (error) {
+            notifications.show({ color: 'red', message: errorMessage(error) })
+        } finally {
+            setBusy(false)
+        }
+    }
+
+    const apply = async () => {
+        if (!plan) return
+        setBusy(true)
+        try {
+            const result = await api<{ newAddress: string; warning?: string }>(
+                token,
+                '/ip-change/apply',
+                'POST',
+                { operationId: plan.operationId, confirmation }
+            )
+            notifications.show({
+                color: 'teal',
+                message: result.warning || `IP изменён и проверен: ${result.newAddress}`
+            })
+            setPlan(null)
+            setNodeUuid(null)
+            setNewAddress('')
+            setConfirmation('')
+            onComplete()
+        } catch (error) {
+            notifications.show({ color: 'red', message: errorMessage(error) })
+        } finally {
+            setBusy(false)
+        }
+    }
+
+    return (
+        <Grid gap="lg">
+            <Grid.Col span={{ base: 12, lg: 5 }}>
+                <Paper p="lg" radius="md" withBorder>
+                    <Stack>
+                        <Title order={4}>Смена IP ноды</Title>
+                        <Text c="dimmed" size="sm">
+                            Панель найдёт связанные хосты, маршруты и Hysteria-домены до
+                            применения. DNS обновится через Cloudflare автоматически.
+                        </Text>
+                        <Alert
+                            color={inventory.cloudflare.configured ? 'teal' : 'yellow'}
+                            icon={
+                                inventory.cloudflare.configured ? (
+                                    <TbShieldCheck size={18} />
+                                ) : (
+                                    <TbAlertTriangle size={18} />
+                                )
+                            }
+                            title={
+                                inventory.cloudflare.configured
+                                    ? 'Cloudflare DNS подключён'
+                                    : 'Cloudflare DNS не настроен'
+                            }
+                            variant="light"
+                        >
+                            {inventory.cloudflare.configured
+                                ? `Для доменных Hysteria-нод A-запись изменится вместе с IP и останется DNS only. Зоны: ${inventory.cloudflare.zones.join(', ') || 'подключены'}.`
+                                : 'Смена IP доменной Hysteria-ноды будет заблокирована до подключения API-токена.'}
+                        </Alert>
+                        <SimpleGrid cols={{ base: 1, sm: 2 }}>
+                            <PasswordInput
+                                description="Zone DNS Edit + Zone Read"
+                                label={
+                                    inventory.cloudflare.configured
+                                        ? 'Новый API-токен Cloudflare'
+                                        : 'API-токен Cloudflare'
+                                }
+                                onChange={(event) => setCloudflareToken(event.currentTarget.value)}
+                                placeholder="Токен не отображается после сохранения"
+                                value={cloudflareToken}
+                            />
+                            <TextInput
+                                label="DNS-зона"
+                                onChange={(event) => setCloudflareZone(event.currentTarget.value)}
+                                placeholder="hambot.ru"
+                                value={cloudflareZone}
+                            />
+                        </SimpleGrid>
+                        <Button
+                            disabled={cloudflareToken.length < 20 || !cloudflareZone.trim()}
+                            leftSection={<TbShieldCheck size={17} />}
+                            loading={cloudflareBusy}
+                            onClick={connectCloudflare}
+                            variant="light"
+                        >
+                            {inventory.cloudflare.configured
+                                ? 'Проверить и заменить токен'
+                                : 'Подключить Cloudflare DNS'}
+                        </Button>
+                        <Select
+                            data={inventory.nodes.map((node) => ({
+                                label: `${node.name} · ${node.address}`,
+                                value: node.uuid
+                            }))}
+                            label="Нода"
+                            onChange={(value) => {
+                                setNodeUuid(value)
+                                setPlan(null)
+                            }}
+                            searchable
+                            value={nodeUuid}
+                        />
+                        <TextInput
+                            label="Новый IPv4 или IPv6"
+                            onChange={(event) => {
+                                setNewAddress(event.currentTarget.value)
+                                setPlan(null)
+                            }}
+                            placeholder="203.0.113.20"
+                            value={newAddress}
+                        />
+                        <Button
+                            disabled={!nodeUuid || !newAddress.trim()}
+                            leftSection={<TbTopologyStar3 size={17} />}
+                            loading={busy}
+                            onClick={createPlan}
+                        >
+                            Построить план
+                        </Button>
+                    </Stack>
+                </Paper>
+            </Grid.Col>
+            <Grid.Col span={{ base: 12, lg: 7 }}>
+                <Paper mih={300} p="lg" radius="md" withBorder>
+                    {!plan ? (
+                        <Stack align="center" h={250} justify="center">
+                            <ThemeIcon color="gray" radius="xl" size={54} variant="light">
+                                <TbArrowsExchange size={28} />
+                            </ThemeIcon>
+                            <Text c="dimmed" ta="center">
+                                Выберите ноду и новый адрес — здесь появится точный план изменений.
+                            </Text>
+                        </Stack>
+                    ) : (
+                        <Stack>
+                            <Group justify="space-between">
+                                <Title order={4}>{plan.node.name}</Title>
+                                <Badge color="blue" variant="light">
+                                    План готов
+                                </Badge>
+                            </Group>
+                            <Code block>
+                                {plan.node.oldAddress} → {plan.node.newAddress}
+                            </Code>
+                            <SimpleGrid cols={{ base: 1, sm: 2, xl: 4 }}>
+                                <MetricCard color="blue" label="Нод" value={plan.impact.nodes} />
+                                <MetricCard
+                                    color="violet"
+                                    label="Хостов"
+                                    value={plan.impact.hosts}
+                                />
+                                <MetricCard
+                                    color="grape"
+                                    label="Значений профиля"
+                                    value={plan.impact.profileValues}
+                                />
+                                <MetricCard
+                                    color="teal"
+                                    label="DNS-записей"
+                                    value={plan.impact.dnsRecords}
+                                />
+                            </SimpleGrid>
+                            {plan.hosts.map((host, index) => (
+                                <Alert
+                                    color={host.willChange ? 'blue' : 'gray'}
+                                    key={`${host.remark}-${index}`}
+                                    title={`Хост · ${host.remark}`}
+                                    variant="light"
+                                >
+                                    {host.willChange
+                                        ? `${host.oldAddress} → ${host.newAddress}`
+                                        : 'Связан с нодой, адрес не меняется'}
+                                </Alert>
+                            ))}
+                            {plan.profiles.map((profile) => (
+                                <Alert
+                                    color="violet"
+                                    key={profile.name}
+                                    title={`Профиль · ${profile.name}`}
+                                >
+                                    Точных вхождений IP: {profile.matches}
+                                </Alert>
+                            ))}
+                            {plan.dns.records.map((record) => (
+                                <Alert
+                                    color="teal"
+                                    icon={<TbShieldCheck size={18} />}
+                                    key={record.hostname}
+                                    title={`Cloudflare DNS only · ${record.hostname}`}
+                                    variant="light"
+                                >
+                                    <Stack gap={4}>
+                                        <Code block>
+                                            {record.oldAddress} → {record.newAddress}
+                                        </Code>
+                                        <Text c="dimmed" size="xs">
+                                            TTL: {record.newTtl} сек.
+                                            {record.proxyWasEnabled
+                                                ? ' · Cloudflare Proxy будет отключён'
+                                                : ' · Проксирование выключено'}
+                                        </Text>
+                                    </Stack>
+                                </Alert>
+                            ))}
+                            {plan.warnings.map((warning) => (
+                                <Alert
+                                    color="yellow"
+                                    icon={<TbAlertTriangle size={18} />}
+                                    key={warning}
+                                    title="Требуется ручная проверка"
+                                >
+                                    {warning}
+                                </Alert>
+                            ))}
+                            <Divider />
+                            <TextInput
+                                description="Защита от случайного изменения"
+                                label={`Введите точное имя ноды: ${plan.node.name}`}
+                                onChange={(event) => setConfirmation(event.currentTarget.value)}
+                                value={confirmation}
+                            />
+                            <Button
+                                color="red"
+                                disabled={confirmation !== plan.node.name}
+                                leftSection={<TbShieldCheck size={17} />}
+                                loading={busy}
+                                onClick={apply}
+                            >
+                                Применить, проверить и сохранить
+                            </Button>
+                        </Stack>
+                    )}
+                </Paper>
+            </Grid.Col>
+        </Grid>
+    )
+}
+
+function NodeAddView({
+    inventory,
+    onComplete,
+    token
+}: {
+    inventory: Inventory
+    onComplete: () => void
